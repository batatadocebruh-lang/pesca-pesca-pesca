{
  "name": "pesca-macros-roblox-bot",
  "version": "2.0.0",
  "description": "Automação unificada de pesca e macros/autoclicker no Roblox com keysender, uiohook-napi e template matching BGRA",
  "main": "bot.ts",
  "scripts": {
    "start": "tsc && node --expose-gc --max-old-space-size=96 dist/bot.js",
    "config": "tsc && node --expose-gc --max-old-space-size=96 dist/bot.js config",
    "test": "tsc && node --expose-gc --max-old-space-size=96 dist/bot.js test",
    "build": "tsc"
  },
  "dependencies": {
    "keysender": "^2.4.0",
    "pngjs": "^7.0.0",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
